{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "today-fridge",
  "main": "cloudflare-worker.js",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "routes": [
    {
      "pattern": "onaeng.com",
      "custom_domain": true
    },
    {
      "pattern": "www.onaeng.com",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "CLOUDFLARE_WORKER": "true",
    "PUBLIC_APP_URL": "https://onaeng.com",
    "ALLOWED_ORIGINS": "https://onaeng.com,https://www.onaeng.com"
  }
}
