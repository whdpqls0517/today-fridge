{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "today-fridge",
  "main": "cloudflare-worker.js",
  "compatibility_date": "2026-07-29",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "routes": [
    {
      "pattern": "onaeng.com",
      "custom_domain": true
    },
    {
      "pattern": "www.onaeng.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "BACKEND_ORIGIN": "https://onaeng-api.onrender.com"
  }
}
